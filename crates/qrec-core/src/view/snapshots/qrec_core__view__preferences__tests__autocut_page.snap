---
source: crates/qrec-core/src/view/preferences.rs
expression: autocut
---
{
  "group": {
    "title": "New projects",
    "description": "A project's own autocut settings are on its autocut page (Shift C)."
  },
  "autoRun": {
    "label": "Run autocut after every take",
    "caption": "Cuts the silences of each take as it lands.",
    "on": false,
    "key": "autocut.auto_run_after_take"
  },
  "knobs": [
    {
      "text": {
        "label": "Threshold",
        "caption": "Anything quieter is silence.",
        "tooltip": "Audio quieter than this counts as silence. Raise it (toward 0 dB) if background noise hides your pauses; lower it if quiet words get cut."
      },
      "value": "−35",
      "unit": "dB",
      "key": "autocut.threshold_db",
      "min": -90.0,
      "max": 0.0,
      "step": 1.0
    },
    {
      "text": {
        "label": "Min silence",
        "caption": "Only silences at least this long are cut.",
        "tooltip": "Only quiet stretches at least this long can be cut. Shorter pauses, like the ones between words, always stay."
      },
      "value": "400",
      "unit": "ms",
      "key": "autocut.min_silence_ms",
      "min": 0.0,
      "max": 60000.0,
      "step": 50.0
    },
    {
      "text": {
        "label": "Padding",
        "caption": "Audio kept on each side of speech.",
        "tooltip": "Silence kept on each side of every cut, next to the sound, so words don't start or end abruptly. The timeline shows it in blue."
      },
      "value": "80",
      "unit": "ms",
      "key": "autocut.padding_ms",
      "min": 0.0,
      "max": 60000.0,
      "step": 10.0
    },
    {
      "text": {
        "label": "Min keep",
        "caption": "Sounds shorter than this between cuts are cut too.",
        "tooltip": "The shortest sound worth keeping. A shorter one left between silences, like a click or a breath, is cut with them; padding doesn't count."
      },
      "value": "50",
      "unit": "ms",
      "key": "autocut.min_keep_ms",
      "min": 0.0,
      "max": 60000.0,
      "step": 10.0
    }
  ],
  "footer": "Changes are saved to ~/.config/qrec/config.toml.",
  "footerPath": "~/.config/qrec/config.toml"
}
