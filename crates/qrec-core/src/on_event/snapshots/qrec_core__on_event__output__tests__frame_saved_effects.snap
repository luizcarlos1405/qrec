---
source: crates/qrec-core/src/on_event/output.rs
expression: out.effects
---
[
    Reply {
        req: ReqId(
            "r1",
        ),
        reply: Ok(
            CmdResult {
                seq: None,
                created: [],
                removed: [],
                message: "Saved /p/frames/a.png",
                result: Object {
                    "path": String("/p/frames/a.png"),
                },
            },
        ),
    },
    Notify(
        Toast {
            level: Success,
            title: "Frame saved",
            body: Some(
                "frames/a.png",
            ),
            actions: [
                ToastAction {
                    label: "Copy image",
                    action: CopyImage(
                        "frames/a.png",
                    ),
                },
                ToastAction {
                    label: "Open folder",
                    action: RevealPath(
                        "frames/a.png",
                    ),
                },
            ],
        },
    ),
]
