      "x",
      "BackSpace"
    ],
    "cli": "qrec clip remove <clip>…",
    "contexts": [
      "global"
    ]
  },
  {
    "id": "autocut.run",
    "group": "Edit",
    "label": "Autocut the selection, or every clip",
    "keys": [
