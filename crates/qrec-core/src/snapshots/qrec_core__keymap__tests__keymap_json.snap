---
source: crates/qrec-core/src/keymap.rs
expression: "keys_view(&resolve(\"\"))"
---
[
  {
    "id": "record.toggle",
    "group": "Record",
    "label": "Toggle record",
    "keys": [
      "r"
    ],
    "cli": "qrec record toggle",
    "contexts": [
      "global",
      "recording"
    ]
  },
  {
    "id": "record.over",
    "group": "Record",
    "label": "Record over selection",
    "keys": [
