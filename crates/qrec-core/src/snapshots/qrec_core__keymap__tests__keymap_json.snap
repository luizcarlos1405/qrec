    ],
    "cli": null,
    "contexts": [
      "global",
      "recording"
    ]
  },
  {
    "id": "clip.move-left",
    "group": "Edit",
    "label": "Move selection left one slot",
    "keys": [
      "less"
    ],
    "cli": "qrec clip move <clip>… --by -1",
    "contexts": [
      "global"
    ]
  },
  {
    "id": "clip.move-right",
    "group": "Edit",
    "label": "Move selection right one slot",
    "keys": [
      "greater"
    ],
    "cli": "qrec clip move <clip>… --by 1",
    "contexts": [
      "global"
    ]
  },
  {
    "id": "clip.split",
    "group": "Edit",
    "label": "Split clip at the playhead",
    "keys": [
      "s"
    ],
    "cli": "qrec clip split <clip> --at <t>",
    "contexts": [
      "global"
    ]
  },
  {
    "id": "clip.trim-start",
    "group": "Edit",
    "label": "Trim start to the playhead",
    "keys": [
      "bracketleft"
    ],
    "cli": "qrec clip trim <clip> --start <t>",
    "contexts": [
      "global"
    ]
  },
  {
    "id": "clip.trim-end",
    "group": "Edit",
    "label": "Trim end to the playhead",
    "keys": [
      "bracketright"
    ],
    "cli": "qrec clip trim <clip> --end <t>",
    "contexts": [
      "global"
    ]
  },
  {
    "id": "clip.nudge-start",
    "group": "Edit",
    "label": "Trim 1 frame off the start",
    "keys": [
      "alt+bracketleft"
    ],
    "cli": "qrec clip trim <clip> --start +1f",
    "contexts": [
      "global"
    ]
  },
  {
    "id": "clip.nudge-end",
    "group": "Edit",
    "label": "Trim 1 frame off the end",
    "keys": [
      "alt+bracketright"
    ],
    "cli": "qrec clip trim <clip> --end -1f",
    "contexts": [
      "global"
    ]
  },
  {
    "id": "clip.nudge-start-10",
    "group": "Edit",
    "label": "Trim 10 frames off the start",
    "keys": [
      "alt+braceleft"
    ],
    "cli": "qrec clip trim <clip> --start +10f",
    "contexts": [
      "global"
    ]
  },
  {
    "id": "clip.nudge-end-10",
    "group": "Edit",
    "label": "Trim 10 frames off the end",
    "keys": [
      "alt+braceright"
    ],
    "cli": "qrec clip trim <clip> --end -10f",
    "contexts": [
      "global"
    ]
  },
  {
    "id": "clip.remove",
    "group": "Edit",
    "label": "Remove selected clips (to the bin)",
    "keys": [
