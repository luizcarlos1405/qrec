---
source: crates/qrec-core/src/keymap.rs
expression: "keys_view(&resolve(\"\"))"
---
[
  {
    "id": "record.toggle",
    "group": "Record",
    "label": "Start / stop recording",
    "keys": [
      "r"
    ],
    "cli": "qrec record toggle",
    "contexts": [
      "global",
      "recording"
    ]
  },
  {
    "id": "record.over",
    "group": "Record",
    "label": "Record over the selection",
    "keys": [
      "o"
    ],
    "cli": "qrec record start --over <clip>…",
    "contexts": [
      "global"
    ]
  },
  {
    "id": "take.discard-last",
    "group": "Record",
    "label": "Discard the last take (to the bin)",
    "keys": [
      "d"
    ],
    "cli": "qrec take discard-last",
    "contexts": [
      "global",
      "recording"
    ]
  },
  {
    "id": "cancel",
    "group": "Record",
    "label": "Cancel recording, deselect, close overlay",
    "keys": [
      "Escape"
    ],
    "cli": "qrec record cancel",
    "contexts": [
      "global",
      "recording",
      "overlay"
    ]
  },
  {
    "id": "play.toggle",
    "group": "Playback",
    "label": "Play / pause",
    "keys": [
      "space"
    ],
    "cli": "qrec play",
    "contexts": [
      "global",
      "recording"
    ]
  },
  {
    "id": "shuttle.reverse",
    "group": "Playback",
    "label": "Shuttle reverse (again: 2×, 4×)",
    "keys": [
      "j"
    ],
    "cli": null,
    "contexts": [
      "global"
    ]
  },
  {
    "id": "shuttle.stop",
    "group": "Playback",
    "label": "Shuttle stop",
    "keys": [
      "k"
    ],
    "cli": null,
    "contexts": [
      "global"
    ]
  },
  {
    "id": "shuttle.forward",
    "group": "Playback",
    "label": "Shuttle forward (again: 2×, 4×)",
    "keys": [
      "l"
    ],
    "cli": null,
    "contexts": [
      "global"
    ]
  },
  {
    "id": "seek.prev-frame",
    "group": "Playback",
    "label": "Previous frame",
    "keys": [
      "Left"
    ],
    "cli": "qrec seek --by -1f",
    "contexts": [
      "timeline",
      "recording"
    ]
  },
  {
    "id": "seek.next-frame",
    "group": "Playback",
    "label": "Next frame",
    "keys": [
      "Right"
    ],
    "cli": "qrec seek --by +1f",
    "contexts": [
      "timeline",
      "recording"
    ]
  },
  {
    "id": "seek.back",
    "group": "Playback",
    "label": "Back 1 s",
    "keys": [
      "shift+Left"
    ],
    "cli": "qrec seek --by -1s",
    "contexts": [
      "timeline",
      "recording"
    ]
  },
  {
    "id": "seek.forward",
    "group": "Playback",
    "label": "Forward 1 s",
    "keys": [
      "shift+Right"
    ],
    "cli": "qrec seek --by +1s",
    "contexts": [
      "timeline",
      "recording"
    ]
  },
  {
    "id": "seek.prev-edit",
    "group": "Playback",
    "label": "Previous edit point",
    "keys": [
