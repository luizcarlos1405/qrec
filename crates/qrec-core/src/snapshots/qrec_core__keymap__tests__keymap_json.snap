    ],
    "cli": "qrec seek --edit prev",
    "contexts": [
      "timeline",
      "recording"
    ]
  },
  {
    "id": "seek.next-edit",
    "group": "Playback",
    "label": "Next edit point",
    "keys": [
      "Down"
    ],
    "cli": "qrec seek --edit next",
    "contexts": [
      "timeline",
      "recording"
    ]
  },
  {
    "id": "seek.start",
    "group": "Playback",
    "label": "Timeline start",
    "keys": [
      "Home"
    ],
    "cli": "qrec seek --to start",
    "contexts": [
      "global",
      "recording"
    ]
  },
  {
    "id": "seek.end",
    "group": "Playback",
    "label": "Timeline end",
    "keys": [
      "End"
    ],
    "cli": "qrec seek --to end",
    "contexts": [
      "global",
      "recording"
    ]
  },
