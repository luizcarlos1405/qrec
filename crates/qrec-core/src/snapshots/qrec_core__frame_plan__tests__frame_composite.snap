    [1:v]fps=30/1,setpts=PTS-STARTPTS,crop=960:720:160:0,scale=384:288:flags=bilinear,format=yuva420p,lutyuv=a=val*0.75[l1]
    [base][l0]overlay=x=0:y=0:eof_action=pass[o0]
